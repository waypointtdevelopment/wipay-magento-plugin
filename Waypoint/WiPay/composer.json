{
    "name": "waypoint/module-wipay",
    "description": "Hosted card checkout for Magento / Adobe Commerce using WiPay's Payments API.",
    "type": "magento2-module",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "magento/framework": "*",
        "magento/module-payment": "*",
        "magento/module-checkout": "*",
        "magento/module-sales": "*"
    },
    "suggest": {
        "ext-curl": "Required for calling the WiPay Payments API and WAPI."
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Waypoint\\WiPay\\": ""
        }
    }
}
